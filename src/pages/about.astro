---
import BaseLayout from '../layouts/BaseLayout.astro';
import InkCanvas from '../components/InkCanvas.astro';
---

<BaseLayout title="关于 —— 拾阶 Gleanstep" description="关于拾阶与拾阶背后的人。">
  <InkCanvas />
  <main class="mx-auto flex min-h-[70vh] max-w-3xl flex-col items-center justify-center gap-6 px-6 text-center">
    <h1 class="text-5xl tracking-[0.2em]">我</h1>
    <div class="space-y-3 leading-loose text-fg-soft">
      <p>拾阶而行,采撷沿途。</p>
      <p>这里是 Gleanstep —— 一个放名片、写博客、摆小工具的个人所在。</p>
      <p class="text-sm text-fg-faint">关于页将在后续补充完整。</p>
    </div>
    <a href={import.meta.env.BASE_URL} class="mt-4 border-b border-fg/30 pb-0.5 text-fg-soft transition-colors hover:border-qing hover:text-qing">← 回到首页</a>
  </main>
</BaseLayout>
