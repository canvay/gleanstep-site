---
import BaseLayout from '../../layouts/BaseLayout.astro';
import InkCanvas from '../../components/InkCanvas.astro';
---

<BaseLayout title="博客 —— 拾阶 Gleanstep" description="随笔与札记,正在打磨开笔的第一篇。">
  <InkCanvas />
  <main class="mx-auto flex min-h-[70vh] max-w-3xl flex-col items-center justify-center gap-6 px-6 text-center">
    <h1 class="font-kai text-5xl tracking-[0.2em]">文</h1>
    <p class="text-lg text-fg-soft">博客正在筹备,第一篇《Gleanstep 缘起》尚未开笔。</p>
    <p class="text-sm text-fg-faint">内容体系(Content Collections)将在下一阶段接入。</p>
    <a href={import.meta.env.BASE_URL} class="mt-4 border-b border-fg/30 pb-0.5 text-fg-soft transition-colors hover:border-qing hover:text-qing">← 回到首页</a>
  </main>
</BaseLayout>
