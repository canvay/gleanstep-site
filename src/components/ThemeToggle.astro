---
/**
 * 主题切换按钮:太阳 / 月亮图标随 .dark 类切换显隐
 */
---

<button
  id="theme-toggle"
  type="button"
  aria-label="切换明暗模式"
  class="grid size-9 place-items-center rounded-full border border-fg/20 text-fg-soft transition-colors hover:border-accent hover:text-accent"
>
  <!-- 月(暗色显示) -->
  <svg class="hidden size-4 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
    <path d="M20.5 14.5A8.5 8.5 0 0 1 9.5 3.5a8.5 8.5 0 1 0 11 11Z" />
  </svg>
  <!-- 日(明色显示) -->
  <svg class="block size-4 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
    <circle cx="12" cy="12" r="4" />
    <path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5 5l1.4 1.4M17.6 17.6 19 19M19 5l-1.4 1.4M6.4 17.6 5 19" />
  </svg>
</button>
